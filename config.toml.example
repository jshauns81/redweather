# RedWeather Configuration Example
# Place this file at: ~/.config/redweather/config.toml

# Temperature and speed units: "imperial" (°F, mph) or "metric" (°C, m/s)
units = "imperial"  # or "metric"

# UI customization (for Waybar tooltip)
[ui]
font_size = 9           # Font size for tooltip text
max_desc_len = 10       # Maximum length for weather descriptions

# Colors (hex codes, used in Waybar tooltip Pango markup)
[colors]
header = "#f4b8e4"      # Header text color
text = "#ffffff"        # Regular text color

# Dashboard settings (for the --dashboard GTK4 window)
[dashboard]
show_hourly_graph = true   # Display the animated hourly temperature/precip graph
forecast_hours = 24        # Number of hours shown in the hourly graph
forecast_days = 5          # Number of days in the daily forecast (min 5, max 12)
# window_width = 500       # Initial window width in pixels
# window_height = 700      # Initial window height in pixels
# max_window_height = 900  # Optional maximum window height cap

# Multiple location presets (single source of truth)
# Define as many as you like and choose which one is active.
# Presets can be managed via the UI (--prompt) or edited here directly.
[[location_presets]]
name = "home"
lat = 40.7128
lon = -74.0060
label = "New York, NY"

[[location_presets]]
name = "work"
lat = 34.0522
lon = -118.2437
label = "Los Angeles, CA"

[[location_presets]]
name = "vacation"
lat = 25.7617
lon = -80.1918
label = "Miami, FL"

# Set which preset is currently active
active_preset = "home"  # Use the "home" location

# Temperature color bands (catppuccin-inspired palette)
# Temperatures at or below `max` will use the corresponding color.
# The last band should use a high value to catch everything above.
[[temp_bands]]
max = 59.0
color = "#8caaee"  # Cool blue

[[temp_bands]]
max = 64.0
color = "#85c1dc"

[[temp_bands]]
max = 70.0
color = "#99d1db"  # Comfortable teal

[[temp_bands]]
max = 75.0
color = "#81c8be"

[[temp_bands]]
max = 81.0
color = "#a6d189"  # Warm green

[[temp_bands]]
max = 86.0
color = "#e5c890"  # Yellow

[[temp_bands]]
max = 90.0
color = "#ef9f76"  # Orange

[[temp_bands]]
max = 92.0
color = "#ea999c"  # Hot pink

[[temp_bands]]
max = 500.0
color = "#e78284"  # Very hot red
