// Add this block inside your Waybar config (~/.config/waybar/config)
// Left-click  → full GTK4 dashboard
// Right-click → lightweight layer-shell popup
"custom/weather": {
    "return-type": "json",
    "exec": "OWM_API_KEY=$OWM_API_KEY redweather",
    "interval": 900,
    "tooltip": true,
    "on-click": "redweather --dashboard",
    "on-click-right": "redweather --popup"
}